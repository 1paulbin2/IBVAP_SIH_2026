{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TrackingContract",
  "type": "object",
  "properties": {
    "camera_id": { "type": "string" },
    "track_id": { "type": "string" },
    "class": { "type": "string" },
    "bbox": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 4,
      "maxItems": 4
    },
    "timestamp": { "type": "string", "format": "date-time" },
    "tracking_metadata": { "type": "object" }
  },
  "required": ["camera_id", "track_id", "class", "bbox", "timestamp"]
}
