{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EventContract",
  "type": "object",
  "properties": {
    "event_id": { "type": "string" },
    "camera_id": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "event_type": { "type": "string" },
    "object_track": { "type": "string" },
    "zone_rule": { "type": "string" },
    "evidence_reference": { "type": "string" }
  },
  "required": ["event_id", "camera_id", "timestamp", "event_type", "object_track", "zone_rule", "evidence_reference"]
}
